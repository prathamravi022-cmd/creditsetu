# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=govt_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# MSG91 (SMS Provider — India-focused)
# Get from: https://msg91.com → Settings → Auth Key
MSG91_AUTH_KEY=your_msg91_auth_key_here
# Get from: https://msg91.com → OTP → Templates
MSG91_TEMPLATE_ID=your_template_id_here
MSG91_SENDER_ID=CRDSTU

# Test OTP (dev mode only — disabled in production)
TEST_OTP_ENABLED=True
TEST_ADMIN_OTP=220303
TEST_ADMIN_MOBILE=9259609658

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
